# FinTrack — Supabase Environment Configuration
# Copy this file to .env.local and fill in your actual Supabase project credentials.
# Note: VITE_SUPABASE_PUBLISHABLE_KEY can be either your Supabase Publishable Key or Anon Key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
